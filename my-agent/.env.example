LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# xAI Grok Realtime (speech-to-speech LLM)
XAI_API_KEY=

# STT-LLM-TTS pipeline mode (dashboard toggle: Deepgram STT + OpenAI GPT-4.1 +
# Cartesia TTS "Jacqueline").
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=

# Google Gemini vision (describe_visual tool)
GOOGLE_API_KEY=

# OpenRouter (Qwen VLM — in-call photo capture button)
OPENROUTER_API_KEY=

# Gmail SMTP (send_email tool)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Twilio (SMS + WhatsApp confirmations)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=


# Warm SIP transfer to a human (emergency escalation + insurance desk) —
# infra prerequisite: requires a provisioned LiveKit SIP outbound trunk.
# Either set LIVEKIT_SIP_OUTBOUND_TRUNK (a stored trunk ID), or leave it
# unset and provide SIP_TRUNK_HOSTNAME/SIP_AUTH_USERNAME/SIP_AUTH_PASSWORD
# for an inline custom SIP domain instead.
LIVEKIT_SIP_OUTBOUND_TRUNK=
LIVEKIT_SIP_NUMBER=
SIP_TRUNK_HOSTNAME=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
EMERGENCY_MANAGER_PHONE_NUMBER=
INSURANCE_DESK_PHONE_NUMBER=

# Live ops/shop dashboards (frontend/public/ops.html + shop.html). Optional:
# the agent falls back to the embedded demo project if these are unset. Set
# both to override for a real deployment; leave DASHBOARD_SUPABASE_KEY empty to
# disable dashboard writes entirely.
DASHBOARD_SUPABASE_URL=
DASHBOARD_SUPABASE_KEY=
