# Environment variables needed to connect to the LiveKit server that hosts
# the intuService voice agent (same project as ../my-agent and ../frontend).
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch — the deployed agent's registered name (see
# ../my-agent/src/agent.py: @server.rtc_session(agent_name="my-agent")).
AGENT_NAME=my-agent
